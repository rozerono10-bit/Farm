# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูกอัปขึ้น GitHub)
# Copy to .env and fill in real values (.env is not committed)

# ที่อยู่ https ของเซิร์ฟเวอร์นี้ (ใช้กับ LINE Login)
PUBLIC_URL=https://play.farmdtest.com

# เว็บเกมที่อนุญาตให้รับผลล็อกอิน LINE (คั่นด้วย ,)
ALLOWED_ORIGINS=https://farmdtest.com,https://www.farmdtest.com,https://farmdtest.rozerono10.workers.dev

# LINE Login: developers.line.biz > Provider > LINE Login channel
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ส่งอีเมลรหัสเข้าเกม: resend.com > API Keys (ไม่ใส่ = รหัสจะแสดงในหน้าต่างเซิร์ฟเวอร์แทน ใช้ตอนทดสอบ)
RESEND_API_KEY=
MAIL_FROM="Farm <login@farmdtest.com>"

# Backup ไปที่ Cloudflare R2 (ค่าจาก R2 > Manage API tokens) — ใช้กับ backup.sh
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
R2_BUCKET=farm-backup
